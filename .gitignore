# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
*.cover

# Virtual environments
.venv
venv/
env/

# OS
.DS_Store

# LaTeX artifacts
*.aux
*.lof
*.log
*.lot
*.fls
*.out
*.toc
*.fdb_latexmk
*.synctex.gz
*.bbl
*.bcf
*.blg
*.run.xml
*.nav
*.snm
*.vrb
*.fdb_latexmk
*.figlist
*.makefile
*.auxlock
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.ist
*.loa
*.idx
*.ind
*.ilg

# Dataset — fetched at runtime from Hugging Face Hub, never committed
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/sample_audio/

# Models — pushed to the HF model repo directly; DVC manages its own
# tracked paths via .dvc pointer files (added automatically by `dvc add`)
models/*
!models/.gitkeep

# MLflow — regenerable local experiment state, not versioned source.
# mlflow/ is bind-mounted into the mlflow container so bare-metal and
# containerized runs share the same backend store/artifact root.
mlflow/
mlruns/
mlflow.db
mlartifacts/

# DVC — cache/tmp are local-only; dvc.yaml, dvc.lock, .dvc files stay tracked
.dvc/cache
.dvc/tmp

# Airflow — local runtime state (host LocalExecutor home)
.airflow/
airflow/logs/
airflow/airflow.db
airflow/airflow-webserver.pid
airflow/standalone_admin_password.txt

# Docker volumes (if bind-mounted locally for postgres/grafana/prometheus data)
docker/volumes/

# Secrets & credentials — never commit
.env
.env.*
!.env.example
*.pem
credentials.json
kaggle.json
.kaggle/

# Graphify 
graphify-out/